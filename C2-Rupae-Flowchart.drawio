  <diagram name="Hal 19 - Keterangan Simbol dan Off-Page (S)" id="pg19">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="860" pageHeight="534" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="S_lg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;strokeWidth=1;fontSize=12;fontFamily=Helvetica;" value="KETERANGAN FLOWCHART RUPAÉ&lt;br&gt;Simbol: Terminator = Mulai/Selesai; Persegi = Proses; Jajar genjang = Input/Output; Belah ketupat = Keputusan; Persegi bergaris samping = Proses terdefinisi; Pentagon terbalik = Off-page reference.&lt;br&gt;A = Hal 1 Alur Utama / Main Menu&lt;br&gt;B = Hal 2 Register&lt;br&gt;C = Hal 3 Login dan Cek Role&lt;br&gt;D = Hal 4 Lihat Katalog&lt;br&gt;E = Hal 5 Menu Admin&lt;br&gt;F = Hal 6 Menu Petugas&lt;br&gt;G = Hal 7 Menu Pelanggan&lt;br&gt;H = Hal 8 Kelola Data Master&lt;br&gt;I = Hal 9 Kelola Akun&lt;br&gt;J = Hal 10 Kelola Pelanggan&lt;br&gt;K = Hal 11 Lihat dan Cari Transaksi&lt;div&gt;K-C = Hal 11 Lihat dan Cari Transaksi oleh pelanggan&lt;br&gt;&amp;nbsp;L = Hal 12 Buat Rental bagian 1 (barang / paket, tanggal, stok)&lt;br&gt;M = Hal 13 Buat Rental bagian 2 (MUA, biaya, buat transaksi)&lt;br&gt;N = Hal 14 Pembayaran&lt;br&gt;O = Hal 15 Konfirmasi Pengambilan&lt;br&gt;P = Hal 16 Pengembalian dan Denda&lt;br&gt;Q = Hal 17 Pembatalan Otomatis dan Manual&lt;/div&gt;&lt;div&gt;Q-C = Hal 17 Pembatalan Otomatis dan Manual oleh pelanggan&lt;br&gt;R = Hal 18 Laporan dan Grafik&lt;br&gt;E/F/G, E/F, A/E/F/G = kembali ke menu sesuai role pengguna yang sedang login.&lt;br&gt;Klik simbol off-page (A sampai R) untuk loncat ke halaman tujuan.&lt;/div&gt;" vertex="1">
          <mxGeometry height="394" width="760" x="40" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
